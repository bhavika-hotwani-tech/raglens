# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/raglens

# JWT Security
JWT_SECRET_KEY=raglens-enterprise-secret-key-change-in-production-948f2a1b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key and Model for Embeddings (output_dimensionality=768)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001

# Ingestion Upload Directory
UPLOAD_DIR=uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
